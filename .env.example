# Solana
WALLET_MNEMONIC=
SOLANA_RPC_URL=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/memescopesec

# KOL Tracker
KOL_TRACKER_PORT=3002
KOL_TRACKER_WALLET_INDEX=0
KOL_TRACKER_POLL_INTERVAL_MS=5000
KOL_TRACKER_MAX_SLIPPAGE_BPS=300

# Position Sizing Tiers (SOL)
KOL_TRACKER_TIER0_SIZE=0.01
KOL_TRACKER_TIER1_SIZE=0.05
KOL_TRACKER_TIER2_SIZE=0.1
KOL_TRACKER_TIER3_SIZE=0.5
KOL_TRACKER_TIER4_SIZE=1.0

# PnL Thresholds to Advance Tiers
KOL_TRACKER_TIER1_THRESHOLD=0.5
KOL_TRACKER_TIER2_THRESHOLD=2
KOL_TRACKER_TIER3_THRESHOLD=10
KOL_TRACKER_TIER4_THRESHOLD=25

# Transaction Speed
PRIORITY_FEE_MICRO_LAMPORTS=50000
COMPUTE_UNIT_LIMIT=200000

# Pump.fun Tokenized Agent
AGENT_TOKEN_MINT=
AGENT_BUYBACK_BPS=5000
# How often to collect creator fees (ms) — default 30min
AGENT_FEE_COLLECT_INTERVAL_MS=1800000
# Currency for fees (wSOL — creator fees are paid in SOL)
AGENT_CURRENCY_MINT=So11111111111111111111111111111111111111112

# Helius (for webhooks — faster than polling)
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
HELIUS_WEBHOOK_URL=

# Telegram Notifications (errors only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
